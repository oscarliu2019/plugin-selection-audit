\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Lagged agreement of best-arm identity, $127$ groups. The reference used in the \emph  {excess} column is the marginal chance level $\DOTSB \sum@ \slimits@ _k p_k^2 = 0.395$. Per-window re-labeling drives the measured agreement to $0.307$, which matches the uniform-label null $\mathrm  {mean}(1/K) = 0.306$ rather than the marginal level, as it must: re-labeling destroys the marginal concentration along with the association. Any lag $\ell \ge H$ is causally legal and $\ell = H$ is the smallest legal lag, which is why the $H$ row is the deployable one; the $2H$ row is legal too and is shown for the trend.}}{9}{table.8}\protected@file@percent }
\newlabel{tab:persist}{{8}{9}{Lagged agreement of best-arm identity, $127$ groups. The reference used in the \emph {excess} column is the marginal chance level $\sum _k p_k^2 = 0.395$. Per-window re-labeling drives the measured agreement to $0.307$, which matches the uniform-label null $\mathrm {mean}(1/K) = 0.306$ rather than the marginal level, as it must: re-labeling destroys the marginal concentration along with the association. Any lag $\ell \ge H$ is causally legal and $\ell = H$ is the smallest legal lag, which is why the $H$ row is the deployable one; the $2H$ row is legal too and is shown for the trend}{table.8}{}}
